<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Cosmos San Valentín 2026</title>
    <style>
        body, html {
            margin: 0; padding: 0;
            width: 100%; height: 100%;
            background: #0b0518; /* Espacio profundo */
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        #star-canvas {
            position: fixed;
            top: 0; left: 0;
            z-index: 0;
        }

        .floating-element {
            position: absolute;
            white-space: nowrap;
            cursor: pointer;
            transition: transform 0.2s ease-out;
            z-index: 10;
            user-select: none;
        }

        .word {
            color: #ff85a2;
            font-weight: bold;
            text-shadow: 0 0 10px #ff004c;
            font-size: 1.5rem;
        }

        .osito {
            font-size: 3rem; /* Puedes cambiar esto por una etiqueta <img> si tienes el archivo */
            filter: drop-shadow(0 0 5px #fff);
        }

        #ui-layer {
            position: fixed;
            top: 20px; left: 20px;
            z-index: 100;
            color: white;
            background: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 15px;
            backdrop-filter: blur(5px);
        }

        button {
            background: #ff477e;
            border: none;
            color: white;
            padding: 8px 15px;
            border-radius: 20px;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <canvas id="star-canvas"></canvas>

    <div id="ui-layer">
        <h3>✨ Nuestro Universo ✨</h3>
        <p>Haz clic para iniciar la melodía italiana</p>
        <button onclick="playMusic()">🎵 Reproducir Música</button>
        <audio id="italyMusic" loop>
            <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3" type="audio/mpeg">
        </audio>
    </div>

    <script>
        const canvas = document.getElementById('star-canvas');
        const ctx = canvas.getContext('2d');
        let width, height;

        // Configuración de palabras y ositos
        const data = [
            { text: "Amore", type: "word" },
            { text: "🧸", type: "osito" },
            { text: "Tesoro", type: "word" },
            { text: "💖", type: "osito" },
            { text: "Bellissima", type: "word" },
            { text: "🌈", type: "osito" },
            { text: "Sempre", type: "word" },
            { text: "Vita Mia", type: "word" }
        ];

        const elements = [];

        function init() {
            width = window.innerWidth;
            height = window.innerHeight;
            canvas.width = width;
            canvas.height = height;
            createStars();
        }

        function createStars() {
            ctx.clearRect(0, 0, width, height);
            for(let i=0; i<300; i++) {
                ctx.fillStyle = "white";
                ctx.beginPath();
                ctx.arc(Math.random()*width, Math.random()*height, Math.random()*1.5, 0, Math.PI*2);
                ctx.fill();
            }
        }

        class FloatingObject {
            constructor(item) {
                this.el = document.createElement('div');
                this.el.className = `floating-element ${item.type}`;
                this.el.innerText = item.text;
                document.body.appendChild(this.el);

                this.x = Math.random() * (width - 100);
                this.y = Math.random() * (height - 100);
                this.vx = (Math.random() - 0.5) * 1.5;
                this.vy = (Math.random() - 0.5) * 1.5;
            }

            update() {
                this.x += this.vx;
                this.y += this.vy;

                if(this.x <= 0 || this.x >= width - 80) this.vx *= -1;
                if(this.y <= 0 || this.y >= height - 40) this.vy *= -1;

                this.el.style.transform = `translate(${this.x}px, ${this.y}px)`;
            }
        }

        function playMusic() {
            document.getElementById('italyMusic').play();
            document.querySelector('#ui-layer p').innerText = "Disfrutando de nuestra galaxia...";
        }

        // Iniciar
        window.addEventListener('resize', init);
        init();

        data.forEach(item => elements.push(new FloatingObject(item)));

        function animate() {
            elements.forEach(obj => obj.update());
            requestAnimationFrame(animate);
        }
        animate();

        // Efecto visual al mover el mouse
        document.addEventListener('mousemove', (e) => {
            elements.forEach(obj => {
                const dx = e.clientX - obj.x;
                const dy = e.clientY - obj.y;
                const dist = Math.sqrt(dx*dx + dy*dy);
                if(dist < 100) {
                    obj.vx += dx * 0.001;
                    obj.vy += dy * 0.001;
                }
            });
        });

    </script>
</body>
</html>
